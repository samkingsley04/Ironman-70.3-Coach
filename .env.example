ANTHROPIC_API_KEY=your-api-key-here

# TrainingPeaks sync (trainingpeaks_sync.py). Get this from a logged-in browser
# session: DevTools -> Application -> Cookies -> trainingpeaks.com ->
# Production_tpAuth -> Copy value. Expires periodically -- re-copy when the
# sync script reports a 401.
TP_AUTH_COOKIE=your-production-tpauth-cookie-value
